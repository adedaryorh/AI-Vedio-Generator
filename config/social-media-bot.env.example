# Social Media Bot Service Environment Variables

# Instagram
INSTAGRAM_APP_ID=your-app-id
INSTAGRAM_APP_SECRET=your-app-secret
INSTAGRAM_ACCESS_TOKEN=your-access-token

# YouTube
YOUTUBE_API_KEY=your-youtube-api-key

# TikTok (Note: API access is restricted and requires business partnership)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# Infrastructure
DATABASE_URL=postgres://storybot:storybotpass@postgres:5432/storybotdb?sslmode=disable
REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=admin
RABBITMQ_PASS=admin
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672