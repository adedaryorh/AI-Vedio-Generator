FROM node:18-alpine

# Set build arguments for environment variables
ARG NEXT_PUBLIC_STORY_COLLECTOR_URL
ARG NEXT_PUBLIC_VIDEO_GENERATOR_URL
ARG NEXT_PUBLIC_CONTENT_MANAGER_URL
ARG NEXT_PUBLIC_SOCIAL_MEDIA_BOT_URL
ARG NEXT_PUBLIC_ADMIN_USER
ARG NEXT_PUBLIC_ADMIN_PASS

# Set environment variables for the build (these will be inlined into the client-side code)
ENV NEXT_PUBLIC_STORY_COLLECTOR_URL=$NEXT_PUBLIC_STORY_COLLECTOR_URL
ENV NEXT_PUBLIC_VIDEO_GENERATOR_URL=$NEXT_PUBLIC_VIDEO_GENERATOR_URL
ENV NEXT_PUBLIC_CONTENT_MANAGER_URL=$NEXT_PUBLIC_CONTENT_MANAGER_URL
ENV NEXT_PUBLIC_SOCIAL_MEDIA_BOT_URL=$NEXT_PUBLIC_SOCIAL_MEDIA_BOT_URL
ENV NEXT_PUBLIC_ADMIN_USER=$NEXT_PUBLIC_ADMIN_USER
ENV NEXT_PUBLIC_ADMIN_PASS=$NEXT_PUBLIC_ADMIN_PASS

# Set working directory
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Expose port
EXPOSE 3000

# Start the application
CMD ["npm", "start"]